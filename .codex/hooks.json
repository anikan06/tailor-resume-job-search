{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/session-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking against repo guardrails"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/stop-verify.mjs\"",
            "timeout": 180,
            "statusMessage": "Running verify.sh"
          }
        ]
      }
    ]
  }
}
