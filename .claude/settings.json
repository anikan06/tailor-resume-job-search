{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.ai/scripts/verify.sh:*)",
      "Bash(node .ai/scripts/check-invariants.mjs)",
      "Bash(node .ai/scripts/sync-agents.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./server/config/profile.yaml)",
      "Read(./server/data/**)",
      "Edit(./server/data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/session-context.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/guard.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/stop-verify.mjs\"", "timeout": 180 }
        ]
      }
    ]
  }
}
